"""Print one version's notes: its section of CHANGELOG.md, then of the other languages'.

    python3 tools/release-notes 0.2.0

Exits 1 when the French section is missing or empty, so that a version
cannot be published without saying what changed in it. The English,
German and Spanish sections follow it when their changelog has one
(English from 0.9.0, German and Spanish from 0.10.0; a test makes sure
the current version always does).
"""

import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def notes(version, path=os.path.join(ROOT, "CHANGELOG.md")):
    """The text under '## <version> ...', up to the next '## ' heading."""
    lines = []
    inside = False
    with open(path, encoding="utf-8") as handle:
        for line in handle:
            if line.startswith("## "):
                if inside:
                    break
                inside = line[3:].split()[0] == version if line[3:].split() else False
                continue
            if inside:
                lines.append(line)
    return "".join(lines).strip()


if __name__ == "__main__":
    if len(sys.argv) != 2:
        print(__doc__)
        sys.exit(2)
    text = notes(sys.argv[1])
    if not text:
        sys.stderr.write("CHANGELOG.md n'a pas de section pour %s\n" % sys.argv[1])
        sys.exit(1)
    for code, title in (("en", "English"), ("de", "Deutsch"), ("es", "Español")):
        path = os.path.join(ROOT, "CHANGELOG.%s.md" % code)
        other = notes(sys.argv[1], path) if os.path.exists(path) else ""
        if other:
            text += "\n\n---\n\n**%s**\n\n" % title + other
    print(text)

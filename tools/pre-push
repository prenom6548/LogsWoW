#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
# What CLAUDE.md asks before shipping, run by git before every push.
# No network, no service, no dependency. Nothing runs online on a push;
# only a version tag triggers a workflow (.github/workflows/release.yml),
# and this hook is what stands in for CI on everything else.
#
# Install once, from the repository's root:
#     ln -s ../../tools/pre-push .git/hooks/pre-push
# Skip it once, knowingly:  git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! python3 tests/run-tests.py > /dev/null 2>&1; then
    echo "pre-push : des tests echouent -- lancez python3 tests/run-tests.py"
    exit 1
fi

# The fixture carries two deliberately broken lines, so the tool exits 1
# even when every invariant holds: read its verdict, not its exit code.
if ! python3 tools/check-invariants.py examples/exemple-combat.txt 2>&1 \
        | grep -q "All invariants hold"; then
    echo "pre-push : un invariant est viole sur la fixture --" \
         "lancez python3 tools/check-invariants.py examples/exemple-combat.txt"
    exit 1
fi

# The fixture is regenerated by the tests; it must come out unchanged.
if ! git diff --quiet -- examples/exemple-combat.txt; then
    echo "pre-push : tests/make_fixture.py ne regenere plus la meme fixture"
    exit 1
fi

if command -v flake8 > /dev/null 2>&1 && ! flake8 logswow tools tests; then
    echo "pre-push : flake8 signale des ecarts de style"
    exit 1
fi

exit 0

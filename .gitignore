__pycache__/
*.pyc

# Real combat logs never belong in this repository: one carries the names
# and the performance of everyone who was in the group. See PROVENANCE.md.
WoWCombatLog*.txt
*.html

# What tools/build-pyz writes; a release uploads it, the repository never holds it.
dist/

# A report being written: moved into place when whole, removed otherwise.
*.partiel
*.partiel-corps

# What the audit tools leave behind (coverage, mypy).
.coverage
htmlcov/
.mypy_cache/

# The split files a log splitter writes are real logs too.
Split-*.txt
